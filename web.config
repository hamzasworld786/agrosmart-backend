<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="env\Scripts\python.exe" arguments="manage.py runserver %HTTP_PLATFORM_PORT%" stdoutLogEnabled="false" startupTimeLimit="120"/>
  </system.webServer>
</configuration>
